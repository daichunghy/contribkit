{
  "name": "contribkit",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Deterministic contribution preflight for coding agents — do not open the PR until the repo contract is satisfied.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daichunghy/contribkit.git"
  },
  "bugs": {
    "url": "https://github.com/daichunghy/contribkit/issues"
  },
  "homepage": "https://github.com/daichunghy/contribkit#readme",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pull-request",
    "preflight",
    "claude-code",
    "contributing",
    "codeowners",
    "developer-tools"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
