{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daichunghy/contribkit/schemas/contract.v1.json",
  "title": "contribkit.contract.v1",
  "description": "Compiled contribution contract. Stub for P0; compiler not shipped yet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ref", "sources", "rules", "advisory", "needsHuman"],
  "properties": {
    "schema": { "const": "contribkit.contract.v1" },
    "repo": { "type": "string" },
    "ref": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": { "type": "string" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "rules": { "type": "array", "items": { "type": "object" } },
    "advisory": { "type": "array", "items": { "type": "object" } },
    "needsHuman": { "type": "array", "items": { "type": "object" } }
  }
}
